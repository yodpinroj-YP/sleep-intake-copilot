# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and anon (public) key — safe to expose to the browser.
# Find these in your Supabase project: Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER-SIDE ONLY. Bypasses Row Level Security.
# Never prefix this with NEXT_PUBLIC_ and never import it from a Client
# Component. Used only by src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# External AI API
# ---------------------------------------------------------------------------
# Server-side only — read exclusively by src/services/ai/client.ts and
# called from src/app/api/ai/*. Never expose this key to the client.
AI_API_URL=https://api.example-ai-provider.com/v1/chat
AI_API_KEY=your-ai-api-key
AI_MODEL=example-model

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to build email confirmation / OAuth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
